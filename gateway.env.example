# Copy to gateway.env and fill in. gateway.env is git-ignored and kept out of the image:
# never commit it, and never put these values in docker-compose.yml or the Dockerfile.
# docker-compose.yml reads it for the plain server; the simulated live demo does not need it.
# See docs/20-applications-api-keys.md and docs/21-persistence.md.

# A secret of at least 32 characters, e.g. the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Back it up where you keep other secrets: if it is lost or changed, every API key stops
# working.
GATEWAY_KEY_PEPPER=<replace-with-at-least-32-random-characters>

# The vault's master key: 32 random bytes, base64url, e.g. the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# It encrypts organizations' provider keys; the server refuses to start without it. Back it up
# apart from the database: if it is lost, every stored provider key is lost and must be entered
# again. A database backup holds the provider keys sealed under it: never store a backup with
# this key (or this file). Rotating it: docs/32-provider-settings-and-vault.md.
GATEWAY_VAULT_KEY=<replace-with-32-random-bytes-base64url>

# On the gateway-data volume, so it survives the container.
GATEWAY_DATABASE=/data/gateway.db

# How long usage events are kept, in days (the current month is always kept).
GATEWAY_USAGE_RETENTION_DAYS=400

# The first console admin, created only when no platform_admin exists; the server refuses
# to start without one. Its password must pass the policy (12 or more characters, not a
# common one, not containing the username) and be changed at the first login, after which
# this value no longer logs in. Remove both once the admin exists. See
# docs/27-users-and-sessions.md.
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=<replace-with-a-long-random-password>

# How long audit entries are kept, in days.
GATEWAY_AUDIT_RETENTION_DAYS=400

# Mark the session cookie Secure. Only behind HTTPS: over plain HTTP a browser would not
# send it back.
# GATEWAY_COOKIE_SECURE=1
