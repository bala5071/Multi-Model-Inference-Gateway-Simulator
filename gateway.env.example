# Copy to gateway.env and fill in. gateway.env is git-ignored and kept out of the image:
# never commit it, and never put these values in docker-compose.yml or the Dockerfile.
# docker-compose.yml reads it for the plain server; the simulated live demo does not need it.
# See docs/20-applications-api-keys.md and docs/21-persistence.md.

# A secret of at least 32 characters, e.g. the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Back it up where you keep other secrets: if it is lost or changed, every API key stops
# working.
GATEWAY_KEY_PEPPER=<replace-with-at-least-32-random-characters>

# On the gateway-data volume, so it survives the container.
GATEWAY_DATABASE=/data/gateway.db

# How long usage events are kept, in days (the current month is always kept).
GATEWAY_USAGE_RETENTION_DAYS=400
